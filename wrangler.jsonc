{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-wera",
  "compatibility_date": "2025-09-27",
  "main": "./worker.js",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "src/assets",
    "not_found_handling": "single-page-application",
  },
  "compatibility_flags": ["nodejs_compat"],
}
